{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unwritten",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "unwritten.kayworks.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unwritten",
      "database_id": "15ab3fb3-8673-4f5b-8633-1746fb6fa677",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "unwritten"
    }
  ]
}
